# Copy this file to .env and replace local credentials before starting.
NODE_ENV=development
PORT=3000
ALLOWED_ORIGIN=http://localhost:3000

# Generate a session secret with: npm run secret:generate
SESSION_SECRET=replace-this-with-a-generated-secret

# Local SQLite database. Prisma resolves this path relative to prisma.config.ts.
DATABASE_URL=file:./dev.db

# Future PostgreSQL deployment will use a pooled DATABASE_URL and a separate
# DIRECT_URL for Prisma migrations. Do not set these for local SQLite work.

# Optional for local development (uploads are saved under public/uploads).
# Required in production for durable Vercel Blob image storage.
BLOB_READ_WRITE_TOKEN=

# Optional first-admin bootstrap. Leave all three blank to seed categories only.
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=
ADMIN_INITIAL_NAME=System Administrator
