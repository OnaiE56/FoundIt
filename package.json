{
  "name": "foundit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "predev": "prisma generate",
    "dev": "node --watch backend/server.js --mobile",
    "start": "node backend/server.js",
    "test": "node --test",
    "build": "node scripts/sync-frontend.mjs",
    "postinstall": "node scripts/sync-frontend.mjs",
    "sync:frontend": "node scripts/sync-frontend.mjs",
    "secret:generate": "node scripts/generate-session-secret.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio",
    "prisma:validate": "prisma validate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@quixo3/prisma-session-store": "^3.1.21",
    "@vercel/blob": "^2.9.0",
    "bcrypt": "^6.0.0",
    "busboy": "^1.6.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "^8.0.0"
    },
    "@vercel/cli-config": {
      "zod": "^4.6.7"
    }
  },
  "allowScripts": {
    "bcrypt": true,
    "prisma": true,
    "@prisma/engines": true,
    "@prisma/client": true
  }
}
